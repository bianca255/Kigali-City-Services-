rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────────────────────────
    // Users collection
    // ───────────────────────────────────────────
    match /users/{userId} {
      // Any authenticated user can read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;

      // Only the owner can create/update their profile
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasAll([
                         'email', 'displayName', 'emailVerified',
                         'createdAt', 'notificationsEnabled'
                       ]);

      allow update: if request.auth != null
                    && request.auth.uid == userId;

      // Deny deletion through the client
      allow delete: if false;
    }

    // ───────────────────────────────────────────
    // Listings collection
    // ───────────────────────────────────────────
    match /listings/{listingId} {
      // Anyone authenticated can read all listings
      allow read: if request.auth != null;

      // Authenticated users can create new listings
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.keys().hasAll([
                         'name', 'category', 'address', 'contactNumber',
                         'description', 'location', 'createdBy',
                         'createdByName', 'createdAt'
                       ])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.category is string
                    && request.resource.data.location.lat is number
                    && request.resource.data.location.lng is number;

      // Only the listing owner can update
      allow update: if request.auth != null
                    && resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdBy == request.auth.uid;

      // Only the listing owner can delete
      allow delete: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;
    }
  }
}
